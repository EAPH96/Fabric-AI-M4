# Variables del HR Assistant. Copia este archivo a .env y llena solo lo que necesites.
# Nunca subas .env al repositorio: API_KEYS, CF_API_TOKEN y LANGSMITH_API_KEY son secretos.
# Las variables vacías toman su valor por omisión (ver README.md).

# Sesión 1: modelo, agente y datos
# fake (simulado, sin red) o gateway (Workers AI a través de Cloudflare AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Sesión 2: observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Sesión 3: Cloudflare AI Gateway (obligatorias con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=

# Sesión 3: modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
# 0 apaga la caché; con más de 0 Cloudflare guarda respuestas con datos de empleados
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json

# Sesión 4: acceso, límite y compliance
# development o production; con production el producto no arranca si usa el modelo
# simulado, si no hay claves o alguna tiene menos de 16 caracteres, o si las trazas
# están encendidas sin HIDE_INPUTS=true y HIDE_OUTPUTS=true.
ENVIRONMENT=development
# Secreto. Forma: cliente:clave,cliente2:clave2 (cliente con A-Z a-z 0-9 _ -; clave sin
# espacios). Sin claves, todo POST /ask responde 401. Escribe aquí tus propias claves.
API_KEYS=
# Peticiones por cliente por minuto; la siguiente responde 429 con Retry-After.
RATE_LIMIT_PER_MINUTE=30

# Especificación 05: enlace al otro producto en el encabezado de la página
# URL del Asistente de políticas de RH; vacía: sin enlace. En Render se escribe a mano
# en Environment cuando exista la URL de Políticas.
COMPANION_URL=
COMPANION_NAME=Asistente de políticas de RH
